<?xml version="1.0" encoding="utf-8"?>

<com.example.qorrah_app.DomeCameraChamber
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cameraChamber"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:layout_gravity="bottom"
    android:clipChildren="false">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Premium dark translucent layer over camera preview -->
    <View
        android:id="@+id/cameraScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#14000000" />

    <!-- Capture counter -->
    <TextView
        android:id="@+id/captureCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="22dp"
        android:text="0"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:background="@drawable/bg_capture_count"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- Main camera controls -->
    <LinearLayout
        android:id="@+id/cameraControls"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal">

        <Space
            android:layout_width="70dp"
            android:layout_height="1dp" />

        <!-- Primary shutter -->
        <FrameLayout
            android:id="@+id/shutterButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_camera_shutter_outer" />

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_camera_shutter_inner" />

        </FrameLayout>

        <!-- Done appears after first capture -->
        <TextView
            android:id="@+id/buttonDone"
            android:layout_width="74dp"
            android:layout_height="42dp"
            android:layout_marginStart="18dp"
            android:gravity="center"
            android:text="Done"
            android:textColor="#FFFDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:background="@drawable/bg_camera_done"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</com.example.qorrah_app.DomeCameraChamber>