<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1E8"
    tools:context=".ActualSequentialLearningContentActivity">


    <!-- ============================================================
         TOP APP BAR
         ============================================================ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentTopBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#F5F1E8"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Back -->
        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="#202020" />


        <!-- Learning context -->
        <LinearLayout
            android:id="@+id/contentIdentity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/buttonBack"
            app:layout_constraintEnd_toStartOf="@id/buttonContentMenu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">


            <TextView
                android:id="@+id/textContentCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BCS 113: ELECTRONICS"
                android:textColor="#77736B"
                android:textSize="9sp"
                android:fontFamily="sans"
                android:letterSpacing="0.12"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/textContentObjective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Atomic structure and energy bands"
                android:textColor="#171717"
                android:textSize="17sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Content options -->
        <ImageButton
            android:id="@+id/buttonContentMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Content options"
            android:padding="10dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="#292929" />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- ============================================================
         LEARNING CONTENT AREA
         ============================================================ -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/learningContentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="150dp"
        app:layout_constraintTop_toBottomOf="@id/contentTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:id="@+id/learningContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ====================================================
                 SEQUENTIAL PAGE INDICATOR
                 ==================================================== -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pageContextRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">


                <TextView
                    android:id="@+id/textModuleContext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="MODULE 01  ·  OBJECTIVE 01"
                    android:textColor="#8A857C"
                    android:textSize="10sp"
                    android:fontFamily="sans"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/textPageNumber" />


                <TextView
                    android:id="@+id/textPageNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAGE 01"
                    android:textColor="#8A857C"
                    android:textSize="10sp"
                    android:fontFamily="sans"
                    android:letterSpacing="0.10"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>



            <!-- ====================================================
                 LEARNING PAGE TITLE
                 ==================================================== -->

            <TextView
                android:id="@+id/textLearningTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Atomic Structure and Energy Bands"
                android:textColor="#171717"
                android:textSize="31sp"
                android:fontFamily="sans"
                android:letterSpacing="-0.025"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/textLearningIntroduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Understanding the structure of matter provides the foundation for understanding how semiconductor materials behave."
                android:textColor="#68645D"
                android:textSize="15sp"
                android:fontFamily="sans"
                android:lineSpacingExtra="4dp" />



            <!-- ====================================================
                 PRIMARY LEARNING CONTENT
                 ==================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/primaryLearningCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7E1D7"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:id="@+id/primaryLearningContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <TextView
                        android:id="@+id/textSectionHeading001"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Atomic structure"
                        android:textColor="#24211D"
                        android:textSize="20sp"
                        android:fontFamily="sans"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/textSectionBody001"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="An atom consists of a nucleus containing protons and neutrons, surrounded by electrons occupying quantized energy states. The arrangement and energy of these electrons determine many of the electrical properties of a material."
                        android:textColor="#4F4B45"
                        android:textSize="15sp"
                        android:fontFamily="sans"
                        android:lineSpacingExtra="6dp" />


                    <!-- Embedded concept -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/conceptCard001"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardBackgroundColor="#F5F1E8"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E3DCCF"
                        app:strokeWidth="1dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KEY IDEA"
                                android:textColor="#817B70"
                                android:textSize="9sp"
                                android:fontFamily="sans"
                                android:letterSpacing="0.14"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/textKeyIdea001"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="The behaviour of electrons is central to understanding why some materials conduct electricity while others do not."
                                android:textColor="#37332D"
                                android:textSize="13sp"
                                android:fontFamily="sans"
                                android:lineSpacingExtra="3dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:id="@+id/textSectionHeading002"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Energy bands"
                        android:textColor="#24211D"
                        android:textSize="20sp"
                        android:fontFamily="sans"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/textSectionBody002"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="When atoms form a solid, interactions between neighbouring atoms cause their discrete energy levels to broaden into ranges of allowed energies called energy bands. The separation between these bands strongly influences the electrical behaviour of the material."
                        android:textColor="#4F4B45"
                        android:textSize="15sp"
                        android:fontFamily="sans"
                        android:lineSpacingExtra="6dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>



            <!-- ====================================================
                 EMBEDDED IMAGE / DIAGRAM PLACEHOLDER
                 ==================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/embeddedImageCard"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#EEE9E0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDD6CA"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">


                    <TextView
                        android:id="@+id/textEmbeddedImageLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMBEDDED IMAGE"
                        android:textColor="#827C72"
                        android:textSize="9sp"
                        android:fontFamily="sans"
                        android:letterSpacing="0.14"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/textEmbeddedImageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Energy band diagram"
                        android:textColor="#3E3A34"
                        android:textSize="15sp"
                        android:fontFamily="sans"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/textEmbeddedImagePlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Course material image"
                        android:textColor="#8A857C"
                        android:textSize="11sp"
                        android:fontFamily="sans" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>



            <!-- ====================================================
                 NOTES / TUTORIALS
                 ==================================================== -->

            <TextView
                android:id="@+id/textRelatedMaterialTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Related material"
                android:textColor="#24211D"
                android:textSize="20sp"
                android:fontFamily="sans"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7E1D7"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">


                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#F1EDE5"
                        android:gravity="center"
                        android:text="N"
                        android:textColor="#48443D"
                        android:textSize="14sp"
                        android:fontFamily="sans"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/textNotesTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="See notes on this objective"
                            android:textColor="#292621"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/textNotesSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Your saved notes and annotations"
                            android:textColor="#77736B"
                            android:textSize="11sp"
                            android:fontFamily="sans" />

                    </LinearLayout>


                    <ImageButton
                        android:id="@+id/buttonOpenNotes"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Open notes"
                        android:padding="8dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#36332F" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tutorialsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E7E1D7"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">


                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#F1EDE5"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="#48443D"
                        android:textSize="12sp"
                        android:fontFamily="sans" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/textTutorialsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="See tutorials and references"
                            android:textColor="#292621"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/textTutorialsSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Learning resources linked to this objective"
                            android:textColor="#77736B"
                            android:textSize="11sp"
                            android:fontFamily="sans" />

                    </LinearLayout>


                    <ImageButton
                        android:id="@+id/buttonOpenTutorials"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Open tutorials"
                        android:padding="8dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#36332F" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>



            <!-- ====================================================
                 NEXT PAGE
                 ==================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nextPageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDD6CA"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/textNextPageLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT"
                            android:textColor="#8A857C"
                            android:textSize="9sp"
                            android:fontFamily="sans"
                            android:letterSpacing="0.14"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/textNextPageTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Continue to the next page"
                            android:textColor="#292621"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <ImageButton
                        android:id="@+id/buttonNextPage"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next page"
                        android:padding="9dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#36332F" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Bottom breathing room -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



    <!-- ============================================================
         QORRAH CONTEXTUAL KNOWLEDGE GATEWAY

         IMPORTANT:
         This is the ONLY screen in the current navigation sequence
         where the + Qorrah control appears.
         ============================================================ -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/qorrahActionBubble"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginBottom="22dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#E8E2D8"
        app:cardCornerRadius="29dp"
        app:cardElevation="4dp"
        app:strokeColor="#D7D0C4"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:id="@+id/qorrahActionBubbleContent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="21dp"
            android:paddingEnd="21dp">


            <TextView
                android:id="@+id/textQorrahPlus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#24211D"
                android:textSize="22sp"
                android:fontFamily="sans"
                android:textStyle="normal" />


            <TextView
                android:id="@+id/textQorrah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Qorrah"
                android:textColor="#24211D"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>