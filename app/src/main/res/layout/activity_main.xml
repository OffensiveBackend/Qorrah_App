<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1E8"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ========================================================= -->
    <!-- MAIN SCROLLING CONTENT                                    -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="110dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- TOP BAR                                            -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <!-- Qorrah mark -->

                <TextView
                    android:id="@+id/brandMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:text="Q"
                    android:textColor="#151513"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/brandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:text="Qorrah"
                    android:textColor="#151513"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/brandMark"
                    app:layout_constraintStart_toEndOf="@id/brandMark"
                    app:layout_constraintTop_toTopOf="@id/brandMark" />

                <!-- Profile -->

                <TextView
                    android:id="@+id/profileButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="•"
                    android:textColor="#151513"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ================================================= -->
            <!-- COURSE PORTAL / HORIZONTAL COURSE CARDS            -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/coursePortalSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:orientation="vertical">

                <!-- Section heading -->

                <TextView
                    android:id="@+id/coursePortalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:text="YOUR COURSES"
                    android:textColor="#151513"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />


                <!-- ================================================= -->
                <!-- HORIZONTAL COURSE CAROUSEL                         -->
                <!-- ================================================= -->

                <HorizontalScrollView
                    android:id="@+id/courseCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/courseCardContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <!-- ================================================= -->
                        <!-- COURSE CARD 1                                      -->
                        <!-- ================================================= -->

                        <androidx.cardview.widget.CardView
                            android:id="@+id/courseCardOne"
                            android:layout_width="320dp"
                            android:layout_height="178dp"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="20dp">

                                <!-- Course identifier -->

                                <TextView
                                    android:id="@+id/courseCodeOne"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="BCS 113"
                                    android:textColor="#2FA89A"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <!-- Course title -->

                                <TextView
                                    android:id="@+id/courseTitleOne"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="Electronics"
                                    android:textColor="#151513"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/courseCodeOne" />

                                <!-- Portal instruction -->

                                <TextView
                                    android:id="@+id/coursePortalHintOne"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="Open course  •  create a module"
                                    android:textColor="#77746C"
                                    android:textSize="13sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/courseTitleOne" />

                                <!-- Bottom course metadata -->

                                <TextView
                                    android:id="@+id/courseMetaOne"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="6 modules"
                                    android:textColor="#77746C"
                                    android:textSize="11sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent" />

                                <!-- Rename affordance -->

                                <TextView
                                    android:id="@+id/renameCourseOne"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:gravity="center"
                                    android:text="···"
                                    android:textColor="#151513"
                                    android:textSize="18sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>


                        <!-- ================================================= -->
                        <!-- COURSE CARD 2                                      -->
                        <!-- ================================================= -->

                        <androidx.cardview.widget.CardView
                            android:id="@+id/courseCardTwo"
                            android:layout_width="320dp"
                            android:layout_height="178dp"
                            android:layout_marginEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="20dp">

                                <TextView
                                    android:id="@+id/courseCodeTwo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="MAT 121"
                                    android:textColor="#2FA89A"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:id="@+id/courseTitleTwo"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="Differential Calculus"
                                    android:textColor="#151513"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/courseCodeTwo" />

                                <TextView
                                    android:id="@+id/coursePortalHintTwo"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="Open course  •  create a module"
                                    android:textColor="#77746C"
                                    android:textSize="13sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/courseTitleTwo" />

                                <TextView
                                    android:id="@+id/courseMetaTwo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="4 modules"
                                    android:textColor="#77746C"
                                    android:textSize="11sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent" />

                                <TextView
                                    android:id="@+id/renameCourseTwo"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:gravity="center"
                                    android:text="···"
                                    android:textColor="#151513"
                                    android:textSize="18sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>


                        <!-- ================================================= -->
                        <!-- ADD NEW COURSE CARD                               -->
                        <!-- ================================================= -->

                        <androidx.cardview.widget.CardView
                            android:id="@+id/addCourseCard"
                            android:layout_width="320dp"
                            android:layout_height="178dp"
                            android:layout_marginEnd="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:id="@+id/addCourseContent"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/addCoursePlus"
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:gravity="center"
                                    android:text="+"
                                    android:textColor="#151513"
                                    android:textSize="32sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/addCourseText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false"
                                    android:text="add new course"
                                    android:textColor="#68665F"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </HorizontalScrollView>


                <!-- Small carousel position indicator -->

                <LinearLayout
                    android:id="@+id/courseCarouselIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/indicatorOne"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:background="#2FA89A" />

                    <View
                        android:id="@+id/indicatorTwo"
                        android:layout_width="6dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="4dp"
                        android:background="#D7D2C8" />

                    <View
                        android:id="@+id/indicatorThree"
                        android:layout_width="6dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="4dp"
                        android:background="#D7D2C8" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CONTINUE / ACTIVE LEARNING                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/continueSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/continueHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/continueLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="CONTINUE"
                        android:textColor="#151513"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/viewAllContinue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="View all"
                        android:textColor="#2FA89A"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="@id/continueLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/continueLabel" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <!-- Active learning card -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/activeModuleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="178dp"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/activeCourseLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="BCS 111 · INTRODUCTION TO PROGRAMMING"
                            android:textColor="#2FA89A"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/activeModuleTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="Continue where you left off"
                            android:textColor="#151513"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/activeCourseLabel" />

                        <TextView
                            android:id="@+id/activeModuleSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="Pick up your last module without losing your place."
                            android:textColor="#77746C"
                            android:textSize="13sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/activeModuleTitle" />

                        <!-- Progress track -->

                        <View
                            android:id="@+id/progressTrack"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginTop="20dp"
                            android:background="#E7E2D8"
                            app:layout_constraintEnd_toStartOf="@id/progressPercent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/activeModuleSubtitle" />

                        <!-- Progress value -->

                        <View
                            android:id="@+id/progressValue"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:background="#2FA89A"
                            app:layout_constraintEnd_toStartOf="@id/progressPercent"
                            app:layout_constraintHorizontal_bias="0.42"
                            app:layout_constraintStart_toStartOf="@id/progressTrack"
                            app:layout_constraintTop_toTopOf="@id/progressTrack" />

                        <TextView
                            android:id="@+id/progressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="42%"
                            android:textColor="#151513"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@id/progressTrack"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/progressTrack" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- QUIET CLOSING SPACE                                -->
            <!-- ================================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="36dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM NAVIGATION                                         -->
    <!-- ========================================================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#151513"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="⌂"
                    android:textColor="#F5F1E8"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:text="Home"
                    android:textColor="#F5F1E8"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- LIBRARY -->

            <LinearLayout
                android:id="@+id/navLibrary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="◫"
                    android:textColor="#AAA79E"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="Library"
                    android:textColor="#AAA79E"
                    android:textSize="9sp" />

            </LinearLayout>


            <!-- SEARCH -->

            <LinearLayout
                android:id="@+id/navSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="⌕"
                    android:textColor="#AAA79E"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="Search"
                    android:textColor="#AAA79E"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
